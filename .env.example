# Errand Guard settings. Do NOT put real values in this file or commit them.
# Put real values in Hermes's own .env (in your Hermes home folder), for example:
#   hermes config set BITREFILL_API_KEY your-key-here
# `hermes plugins install` also asks for the key and saves it for you.

BITREFILL_API_KEY=          # bitrefill.com -> Account -> Developers (Personal API key)
BITREFILL_BASE_URL=         # optional; default https://api.bitrefill.com/v2
ERRAND_AUTO_APPROVE_MAX=0   # matching payments at or below this skip the extra prompt (0 = always ask)
ERRAND_DAILY_CAP=           # optional; block payments once this much was spent today (0/empty = no cap)
